; Engine configuration file.
; Godot 4.8-dev6 (4.8.dev6.official.8898c2b3d)

config_version=5

[application]

config/name="PetalWild"
config/description="A living garden that can grow into a town."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon=""

[autoload]

PetalContent="*res://scripts/autoload/petal_content.gd"
PetalWorld="*res://scripts/autoload/petal_world.gd"
PetalClock="*res://scripts/autoload/petal_clock.gd"
PetalSave="*res://scripts/autoload/petal_save.gd"
PetalAudio="*res://scripts/autoload/petal_audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/untyped_declaration=0

[rendering]

renderer/rendering_method="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.62, 0.74, 0.58, 1)
