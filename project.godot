; Engine configuration file.
; Godot 4.8-dev6 (4.8.dev6.official.8898c2b3d). Do not float this forward.

config_version=5

[application]

config/name="PetalWild"
config/description="A living garden in Hedge Hollow."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
ContentDB="*res://scripts/autoload/content_db.gd"
Clock="*res://scripts/autoload/clock.gd"
Economy="*res://scripts/autoload/economy.gd"
Trust="*res://scripts/autoload/trust.gd"
SaveGame="*res://scripts/autoload/save_game.gd"
SimLod="*res://scripts/autoload/sim_lod.gd"

[display]

