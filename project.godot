; Engine configuration file.
; Godot 4.8-dev6 (4.8.dev6.official.8898c2b3d). Do not float this forward.

config_version=5

[application]

config/name="PetalWild"
config/description="A living garden in Hedge Hollow."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
ContentDB="*res://scripts/autoload/content_db.gd"
Clock="*res://scripts/autoload/clock.gd"
QualityTier="*res://scripts/core/quality_tier.gd"
Economy="*res://scripts/autoload/economy.gd"
Trust="*res://scripts/autoload/trust.gd"
SaveGame="*res://scripts/autoload/save_game.gd"
SimLod="*res://scripts/autoload/sim_lod.gd"
PetalDecide="*res://scripts/autoload/petal_decide.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.62, 0.76, 0.58, 1)
textures/vram_compression/import_etc2_astc=true
